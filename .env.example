# Copy this file to .env and fill it in. Lines starting with # are comments.
# Everything is optional; the defaults are safe for trying the app on your own computer.
# Details for every setting are in README.md ("Settings").

# ---- Before inviting real farmers: set these ---------------------------------------------------
# Where farmers can write to ask for their answer or photo to be deleted. Photos are kept ONLY when this is set.
PRIVACY_CONTACT=
# Who runs the site (shown on /privacy).
PRIVACY_OPERATOR=
# A long random string. Without it /api/coverage and /api/dataset/* are switched off.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
# Number of reverse proxies in front of the app (nginx, Caddy, a platform router). 0 = none.
# Behind a proxy, 0 makes all farmers share one rate limit; too high lets callers fake their address.
TRUSTED_PROXY_COUNT=0

# ---- Data -----------------------------------------------------------------------------------------
# Where answers and consented photos are stored. Mount this folder as a volume and back it up.
# (The Docker image sets it to /data.)
# DATA_DIR=./data
# Delete answers and photos older than this many days. 0 keeps everything.
# FEEDBACK_RETENTION_DAYS=730
# Signs results so feedback is stored against what the app really said. If empty, a random key is
# created in DATA_DIR. Set it yourself if you run more than one copy of the app.
# FEEDBACK_SECRET=

# ---- Limits (per address, per minute; counted per process) -------------------------------------
# RATE_ANALYZE_PER_MIN=30
# RATE_FEEDBACK_PER_MIN=20
# RATE_GENERAL_PER_MIN=240
# MAX_BODY_BYTES=11534336
# MAX_CONCURRENT_ANALYSES=4
# ANALYSIS_QUEUE_SECONDS=20

# ---- Image analysis and the rice model -------------------------------------------------------------
# Size (pixels, square) a photo is shrunk to before it is measured. Bigger finds smaller spots but is slower and
# changes the blur check; run scripts/calibrate_quality.py before changing it.
# ANALYSIS_SIZE=288
# What rice_model.tflite may do: advisory (logged, does not change the result) or score (adds to the score and the
# confidence). Keep it advisory until its answers have been compared with experts' labels on real photos.
# RICE_MODEL_ROLE=advisory
# How pixels are given to rice_model.tflite: raw (0..255, the supplied model), unit (0..1) or signed (-1..1).
# RICE_INPUT_SCALE=raw

# ---- Other ----------------------------------------------------------------------------------------
# Other websites allowed to call the API from a browser, comma separated. Empty = this site only.
# CORS_ALLOWED_ORIGINS=
# Content-Security-Policy: default, off, or your own policy.
# CSP=default
# Turn on /docs and /openapi.json.
# ENABLE_DOCS=false
# Let the browser send its own model predictions. Leave off: they can be forged.
# ALLOW_CLIENT_ML=false

# ---- Optional services ----------------------------------------------------------------------------
# Kindwise crop.health second opinion. If set, the photo (without GPS data) is sent to Kindwise.
# KINDWISE_API_KEY=
# SARVAM_API_KEY=
# A local language model through Ollama for the written reasoning.
# SLM_ENABLED=false
# SLM_MODEL=qwen3:4b
# OLLAMA_URL=http://127.0.0.1:11434
